# ─── Bot protection ───────────────────────────────────────────────
# Cloudflare Turnstile is the preferred provider. To turn it ON for a
# deployment, set both site key (client) and secret key (server).
# To turn it OFF, leave both blank — the form will accept a "DEV_BYPASS"
# token but the server only honors that bypass when NODE_ENV !== production.
BOT_PROTECTION_PROVIDER=turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional fallback — Google reCAPTCHA v3. Only used if Turnstile site key
# above is blank.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ─── Lead delivery ────────────────────────────────────────────────
LEADPROSPER_ENDPOINT=
LEADPROSPER_API_KEY=
GHL_WEBHOOK_URL=

# ─── Lead certification (compliance) ──────────────────────────────
# Jornaya LeadiD — required by most TCPA-aware buyers. Get your campaign
# ID from https://app.jornaya.com/. The campaign ID is public-safe (it's
# embedded in the script src) so it lives in NEXT_PUBLIC_*.
NEXT_PUBLIC_JORNAYA_CAMPAIGN_ID=

# TrustedForm (ActiveProspect) — also required by most buyers. The script
# is purely client-side and contains no secret, so a simple on/off flag
# is enough.
NEXT_PUBLIC_TRUSTEDFORM_ENABLED=

# ─── Tracking ─────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=

# ─── Partial-form drafts (Vercel KV / Upstash Redis) ──────────────
# Server-side store for "resume where you left off". 7-day TTL.
# In Vercel: enable Vercel KV in the dashboard and the four KV_* env
# vars are auto-injected — only KV_REST_API_URL + KV_REST_API_TOKEN are
# needed at runtime. With Upstash directly, set UPSTASH_REDIS_REST_URL +
# UPSTASH_REDIS_REST_TOKEN instead — the code accepts either pair.
# Leave blank in local dev to use the in-memory fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Optional ─────────────────────────────────────────────────────
# Server-side IP geo fallback (used by /api/geo when Vercel/CF geo
# headers are not present).
IPAPI_TOKEN=
